{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build -- --outDir dist/xiai",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/xiai/assets/:path*"
    },
    {
      "source": "/",
      "destination": "/xiai/index.html"
    },
    {
      "source": "/((?!assets/|yinyuan/|xiai/).*)",
      "destination": "/xiai/index.html"
    }
  ]
}
