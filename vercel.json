{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/v1/images/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/xiai/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/xiai/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/xiai",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/xiai/:path*",
      "destination": "https://xiai-api-344046-5-1463728495.sh.run.tcloudbase.com/api/:path*"
    },
    {
      "source": "/((?!assets/|yinyuan/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
